<div class="container-divider"></div>
<div class="container request-form-page">
  <div class="sub-nav">
    {{breadcrumbs}}
  </div>

  <header class="page-header request-form-header">
    <h1>Abrir solicitação</h1>
    <p class="request-form-subtitle">
      Preencha os dados abaixo. As respostas da equipe chegam em
      <a href="{{page_path 'requests'}}">Minhas solicitações</a>.
    </p>
  </header>

  <div class="request-form-layout">
    <div id="main-content" class="form request-form-card">
      <div id="new-request-form"></div>
    </div>

    <aside class="request-form-aside" aria-label="Dicas para a solicitação">
      <section class="request-form-box request-form-tips">
        <h2>Antes de enviar</h2>
        <ol class="request-form-steps">
          <li>Preencha os campos obrigatórios, marcados com <strong>*</strong>.</li>
          <li>Em devoluções, informe o <strong>CNPJ</strong> e use <strong>Buscar pedidos</strong>: ao escolher o produto, os dados do pedido e da nota são preenchidos sozinhos.</li>
          <li>Anexe as fotos do produto: em devoluções são pelo menos <strong>4 imagens</strong>.</li>
        </ol>
      </section>

      <section class="request-form-box">
        <h2>Depois de enviar</h2>
        <p>Acompanhe o andamento e responda à equipe em <a href="{{page_path 'requests'}}">Minhas solicitações</a>.</p>
        {{#if settings.footer_whatsapp_subtitle}}
          <p class="request-form-contact">
            Dúvidas? WhatsApp
            <a href="{{settings.footer_whatsapp_url}}" target="_blank" rel="noopener">{{settings.footer_whatsapp_subtitle}}</a>
          </p>
        {{/if}}
      </section>
    </aside>
  </div>
</div>

<script type="module">
  import { renderNewRequestForm } from "new-request-form";
  import { initDevolucaoPedidos } from "devolucao-pedidos";

  const container = document.getElementById("new-request-form");

  const settings = {{json settings}};

  // Recolor only this form's Garden widgets (e.g. the submit button) with the
  // highlight color from the theme settings, without changing the theme's
  // global brand_color (kept neutral so titles/logo stay black). The form
  // reads colors from `settings`.
  settings.brand_color = settings.highlight_color;
  settings.brand_text_color = "rgba(255, 255, 255, 1)";

  const props = {
    requestForm: {{json new_request_form}},
    newRequestPath: {{json (page_path 'new_request')}},
    parentId: {{json parent.id}},
    parentIdPath: {{json parent.url}},
    locale: {{json help_center.locale}},
    baseLocale: {{json help_center.base_locale}},
    hasAtMentions: {{json help_center.at_mentions_enabled}},
    userRole: {{json user.role}},
    userId: {{json user.id}},
    brandId: {{json brand.id}},
    organizations: {{json user.organizations}},
    wysiwyg: true,
    answerBotModal: {
      answerBot: {{json answer_bot}},
      hasRequestManagement: {{json help_center.request_management_enabled}},
      isSignedIn: {{json signed_in}},
      helpCenterPath: {{json (page_path 'help_center')}},
      requestsPath: {{json (page_path 'requests')}},
      requestPath: {{json (page_path 'request' id=answer_bot.request_id)}}
    },
  };

  renderNewRequestForm(settings, props, container);

  // Devolução B2B: busca de pedidos por CNPJ + carrossel que preenche os
  // campos do pedido. Só ativa em formulários que têm um campo "CNPJ".
  initDevolucaoPedidos({
    container,
    requestForm: props.requestForm,
    organizations: props.organizations,
  });
</script>
